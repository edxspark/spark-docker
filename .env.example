# 复制为 .env 后按需修改。所有项都有默认值，通常只需改代理。

# 服务监听地址与端口
SPARK_HOST=127.0.0.1
SPARK_PORT=8720

# 数据目录（下载、成片、字幕、登录态都放这里）
# SPARK_DATA_DIR=/absolute/path/to/data

# 数据库（默认 SQLite 落在 <数据目录>/spark.db）
# SPARK_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/spark.db

# 调试日志
SPARK_DEBUG=false

# 同一任务的并发视频数 / 语音合成并发数
SPARK_MAX_CONCURRENT_ITEMS=2
SPARK_MAX_CONCURRENT_TTS=4

# 抖音发布是否无头运行（首次调试建议 false，便于观察页面）
SPARK_DOUYIN_HEADLESS=false

# ffmpeg / ffprobe 路径（留空则自动在 PATH 与 Homebrew 目录中查找）
# SPARK_FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# SPARK_FFPROBE_BIN=/opt/homebrew/bin/ffprobe
